import { create } from "zustand";
import { cloneDeep } from "lodash";
import { Node, Edge, NodeChange, EdgeChange, Viewport, applyNodeChanges, applyEdgeChanges, addEdge } from "@xyflow/react";
import type { NodeData, EdgeType, FlowType, AllNodeType } from "@/types/flow";
import { buildPositionDictionary, getNodeId } from "@/utils/reactflowUtils";
import { track } from "@/customization/utils/analytics";

type FlowStore = {
  // State
  nodes: Node<NodeData, "genericNode">[];
  edges: EdgeType[];
  connectingData: Array<{ data: string[] }>;
  reactFlowInstance: any;
  filterType: any;
  autoSaveFlow: (() => void) | undefined;
  handleDragging: boolean;
  positionDictionary: Record<string, any>;
  currentFlow: FlowType | undefined;
  current_node_id: string | undefined;
  splitMode: 'open' | 'split' | 'close';

  // Actions
  setHandleDragging: (dragging: boolean) => void;
  setReactFlowInstance: (instance: any) => void;
  setNodes: (nodes: Node<NodeData, "genericNode">[]) => void;
  setEdges: (edges: EdgeType[]) => void;
  setConnectingData: (data: Array<{ data: string[] }>) => void;
  addEdge: (edge: Edge) => void;
  setNode: (id: string, nodeData: AllNodeType) => void;
  getFlow: () => { nodes: Node<NodeData, "genericNode">[]; edges: EdgeType[] };
  onNodesChange: (changes: NodeChange[]) => void;
  onEdgesChange: (changes: EdgeChange[]) => void;
  setPositionDictionary: (dict: Record<string, any>) => void;
  isPositionAvailable: (position: { x: number; y: number }) => boolean;
  setCurrentFlow: (flow: FlowType | undefined) => void;
  setCurrentNodeId: (nodeId: string | undefined) => void;
  updateCurrentFlow: (nodes: Node<NodeData, "genericNode">[], edges: EdgeType[], viewport?: Viewport) => void;
  deleteNode: (nodeId: string) => void;
  deleteEdge: (edgeId: string) => void;
  getNode: (id: string) => Node<NodeData, "genericNode"> | undefined;
  getEdge: (id: string) => EdgeType | undefined;
  getSelectedNode: () => Node<NodeData, "genericNode"> | undefined;
  resetFlow: (flow: FlowType | undefined) => void;
  paste: (selection: { nodes: any[]; edges: any[] }, position: { x: number; y: number }) => void;
  setSplitMode: (mode: 'open' | 'split' | 'close') => void;
  setFilterType: (filter: any) => void;
};

const useFlowStore = create<FlowStore>((set, get) => ({
  // Initial state
  nodes: [],
  edges: [],
  connectingData: [],
  reactFlowInstance: null,
  filterType: undefined,
  autoSaveFlow: undefined,
  handleDragging: false,
  positionDictionary: {},
  currentFlow: undefined,
  current_node_id: undefined,
  splitMode: 'open',

  // Actions
  setHandleDragging: (handleDragging) => set({ handleDragging }),
  
  setReactFlowInstance: (reactFlowInstance) => set({ reactFlowInstance }),

  setNodes: (nodes) => {
    set({ nodes });
    // Sync with currentFlow
    const currentFlow = get().currentFlow;
    if (currentFlow) {
      set({
        currentFlow: {
          ...currentFlow,
          data: {
            ...currentFlow.data,
            nodes: nodes
          }
        }
      });
    }
    if (get().autoSaveFlow) {
      get().autoSaveFlow!();
    }
  },
  
  setEdges: (edges) => {
    set({ edges });
    // Sync with currentFlow
    const currentFlow = get().currentFlow;
    if (currentFlow) {
      set({
        currentFlow: {
          ...currentFlow,
          data: {
            ...currentFlow.data,
            edges: edges
          }
        }
      });
    }
  },
  
  setConnectingData: (data) => set({ connectingData: data }),
  
  addEdge: (newEdge) => {
    set({
      edges: addEdge(newEdge, get().edges)
    });
    
    const currentFlow = get().currentFlow;
    if (currentFlow) {
      set({
        currentFlow: {
          ...currentFlow,
          data: {
            ...currentFlow.data,
            edges: addEdge(newEdge, get().edges)
          }
        }
      });
    }
    
    if (get().autoSaveFlow) {
      get().autoSaveFlow!();
    }
  },
  
  // ... (other methods remain the same, just ensure they use the correct types)
  
  // Example of other methods (you'll need to implement the rest similarly)
  getNode: (id) => get().nodes.find(node => node.id === id),
  
  getEdge: (id) => get().edges.find(edge => edge.id === id),
  
  getSelectedNode: () => {
    return get().nodes.find(node => node.selected);
  },
  
  // ... implement other methods as needed
}));

export default useFlowStore;
